# Copy to .env and fill in real values. .env is git-ignored — never commit it.
# All values below are fake placeholders.

# --- Shopify dev store ---------------------------------------------------------------
# Admin API access token of a custom app with ONLY these scopes:
#   read_products, read_inventory, read_orders
# The tool checks the scopes at startup and refuses tokens with any write_* scope.
SHOPIFY_STORE_DOMAIN=your-dev-store.myshopify.com
SHOPIFY_ADMIN_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxx
# Quarterly version: YYYY-01, -04, -07 or -10
SHOPIFY_API_VERSION=2026-07
# The one location whose on-hand stock is compared (Settings > Locations; GID form)
SHOPIFY_LOCATION_ID=gid://shopify/Location/000000000000

# --- ERPNext -------------------------------------------------------------------------
# API key/secret of the dedicated read-only user (docs/erpnext-readonly-user.md)
# Plain http:// is accepted only for localhost; any other host must use https://
ERPNEXT_URL=http://localhost:8080
ERPNEXT_API_KEY=xxxxxxxxxxxxxxx
ERPNEXT_API_SECRET=xxxxxxxxxxxxxxx
ERPNEXT_PRICE_LIST=Standard Selling
# XX = your ERPNext company abbreviation (shown in Setup > Company)
ERPNEXT_WAREHOUSE=Stores - XX
# Comma-separated Item Groups whose items are expected in Shopify
ERPNEXT_ITEM_GROUPS=Products
# Comma-separated stock UOMs that mean "one piece" (Shopify counts whole units)
ERPNEXT_UNIT_UOMS=Nos
# Do ERPNext selling prices include tax? true/false. Leave empty if unknown:
# prices are then not compared (reported as unsupported), never guessed.
ERPNEXT_PRICES_INCLUDE_TAX=
# Name of the Sales Order custom field holding the Shopify order GID
# (e.g. custom_shopify_order_gid). Leave empty to disable order reconciliation.
ERPNEXT_ORDER_ID_FIELD=

# IANA timezone of the ERPNext site (System Settings > Time Zone). Decides which calendar
# day is "today" for Item Price valid_from / valid_upto. Timestamps are stored in UTC.
ERPNEXT_TIMEZONE=America/Edmonton
# Database of the ERPNext site (site_config.json "db_type"). Only mariadb is supported:
# ERPNext selects prices differently on PostgreSQL, so any other value stops the tool.
ERPNEXT_DATABASE=mariadb

# --- Reconciliation ------------------------------------------------------------------
# Must equal both the Shopify store currency and the price list currency
CURRENCY=CAD
# 1-60. Shopify's read_orders scope only exposes the last 60 days (read_all_orders is not used).
ORDER_LOOKBACK_DAYS=30
